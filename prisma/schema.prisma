// GENERATED by scripts/assemble-prisma.mjs - do not edit
// Account 1 base schema. Other accounts add fragments under prisma/fragments/*.prisma;
// the real initial migration is created at merge.
generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
}

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  baseCurrency   String          @default("PKR") @db.VarChar(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  users          User[]
  auditLogs      AuditLog[]
  securityEvents SecurityEvent[]
  settings       SystemSetting[]

  @@map("organizations")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model Menu {
  id    String     @id @default(uuid()) @db.Uuid
  key   String     @unique
  roles RoleMenu[]
  users UserMenu[]

  @@map("menus")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleMenu {
  roleId String @db.Uuid
  menuId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @db.Uuid
  email               String     @unique
  fullName            String
  phone               String?
  passwordHash        String
  status              UserStatus @default(INVITED)
  roleId              String     @db.Uuid
  isPrimarySuperAdmin Boolean    @default(false)
  menusCustomized     Boolean    @default(false)
  mfaEnabled          Boolean    @default(false)
  mfaSecretEnc        String?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id])
  role         Role               @relation(fields: [roleId], references: [id])
  profile      UserProfile?
  permissions  UserPermission[]
  menus        UserMenu[]
  resetTokens  PasswordResetToken[]

  @@index([organizationId, status])
  @@index([organizationId, roleId])
  @@map("users")
}

model UserProfile {
  userId   String  @id @db.Uuid
  jobTitle String?
  timezone String  @default("UTC")
  locale   String  @default("en")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Extra permissions granted to a user on top of the role defaults.
model UserPermission {
  userId       String     @db.Uuid
  permissionId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

/// Menu override rows; only effective when User.menusCustomized = true.
model UserMenu {
  userId String @db.Uuid
  menuId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([userId, menuId])
  @@map("user_menus")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Append-only (enforced by trigger). isProtected rows are only visible to the Primary Super Admin.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  event          String
  actorId        String?      @db.Uuid
  entityType     String
  entityId       String
  requestId      String?
  before         Json?
  after          Json?
  isProtected    Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, event])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Append-only security telemetry (failed logins, password resets, status changes without an audit event name).
model SecurityEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  userId         String?       @db.Uuid
  type           String
  ip             String?
  userAgent      String?
  requestId      String?
  metadata       Json?
  isProtected    Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("security_events")
}

model SystemSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("system_settings")
}


// ---- fragment: cases.prisma
// Account 2 - Case workflow fragment. NO datasource / generator blocks here.
// Cross-fragment references (Organization, User) are plain UUID columns on purpose:
// Prisma requires back-relations on the other model, and those models live in
// schema.base.prisma (Account 1). FKs to organizations/users are added in the
// merge migration (see apps/api/src/cases/CHANGE_REQUESTS.md #1).

enum CaseStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  REJECTED
}

enum CaseDecision {
  ACCEPT
  REJECT
}

enum CaseRevisionType {
  CREATED
  EDITED
  CALL_LENGTH
  ACCEPTED
  REJECTED
  MODIFIED_AFTER_PROCESSING
}

enum CaseAssignmentRole {
  AGENT
  TEAM_LEADER
  OUTSOURCE
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  firstName      String
  lastName       String
  /// Normalised: optional leading "+", then digits only (see packages/validation/src/cases).
  phone          String
  dateOfBirth    DateTime @db.Date
  address        String
  zipCode        String
  extra          Json     @default("{}")
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  case Case?

  @@unique([organizationId, phone])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model Case {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  customerId      String     @unique @db.Uuid
  status          CaseStatus @default(SUBMITTED)
  /// Optimistic-lock counter. Bumped on EVERY mutation of the case aggregate.
  version         Int        @default(1)
  agentId         String     @db.Uuid
  teamLeaderId    String?    @db.Uuid
  /// Outsource user who made the Accept/Reject decision (original decision; not changed by modify-processed).
  processedById   String?    @db.Uuid
  processedAt     DateTime?  @db.Timestamptz(6)
  rejectionReason String?
  submittedAt     DateTime   @default(now()) @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  callRecord  CallRecord?
  decision    AcceptRejectAction?
  assignments CaseAssignment[]
  transitions WorkflowTransition[]
  revisions   CaseRevision[]

  @@index([organizationId, status, submittedAt])
  @@index([organizationId, agentId, submittedAt])
  @@index([organizationId, teamLeaderId, submittedAt])
  @@index([organizationId, processedById, processedAt])
  @@index([organizationId, submittedAt])
  @@index([organizationId, processedAt])
  @@map("cases")
}

model CallRecord {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  caseId          String   @unique @db.Uuid
  durationSeconds Int
  setById         String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([organizationId, durationSeconds])
  @@map("call_records")
}

model CaseAssignment {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  caseId         String             @db.Uuid
  userId         String             @db.Uuid
  role           CaseAssignmentRole
  assignedById   String?            @db.Uuid
  assignedAt     DateTime           @default(now()) @db.Timestamptz(6)
  unassignedAt   DateTime?          @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, role])
  @@index([organizationId, userId, role])
  @@map("case_assignments")
}

/// Append-only log of every executed status transition (system and user).
model WorkflowTransition {
  id             String      @id @default(uuid()) @db.Uuid
  /// Monotonic ordering key. created_at alone is ambiguous: now() is constant inside a transaction.
  seq            BigInt      @default(autoincrement())
  organizationId String      @db.Uuid
  caseId         String      @db.Uuid
  fromStatus     CaseStatus?
  toStatus       CaseStatus
  action         String
  actorId        String?     @db.Uuid
  reason         String?
  requestId      String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, seq])
  @@index([organizationId, createdAt])
  @@map("workflow_transitions")
}

/// Exactly ONE decision per case (unique caseId) = database-level guard against double processing.
model AcceptRejectAction {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  caseId         String       @unique @db.Uuid
  decision       CaseDecision
  actorId        String       @db.Uuid
  reason         String?
  requestId      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, decision, createdAt])
  @@map("accept_reject_actions")
}

/// Append-only history feeding GET /cases/:id/history (CaseHistoryItemDto).
model CaseRevision {
  id             String           @id @default(uuid()) @db.Uuid
  /// Monotonic ordering key (see WorkflowTransition.seq).
  seq            BigInt           @default(autoincrement())
  organizationId String           @db.Uuid
  caseId         String           @db.Uuid
  type           CaseRevisionType
  actorId        String           @db.Uuid
  reason         String?
  before         Json?
  after          Json?
  versionAfter   Int
  requestId      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, seq])
  @@index([organizationId, createdAt])
  @@map("case_revisions")
}


// ---- fragment: finance.prisma
// Account 6 fragment: finance, files, integrations, notifications.
// No datasource/generator blocks (those live in schema.base.prisma, Account 1).
//
// Cross-fragment references (Organization, User, cases) are plain @db.Uuid columns WITHOUT Prisma
// relations, so Account 1's and Account 2's models need no back-relation fields. Add real foreign
// keys in the merge migration if wanted.
//
// MERGE NOTE (raw SQL in the initial migration). Columns keep camelCase names (A5 maps tables only),
// so they must be double-quoted:
//   ALTER TABLE payments ADD CONSTRAINT payments_one_target
//     CHECK (("incomeId" IS NOT NULL)::int + ("expenseId" IS NOT NULL)::int = 1);
//   ALTER TABLE incomes  ADD CONSTRAINT incomes_amount_positive  CHECK ("amount" > 0);
//   ALTER TABLE expenses ADD CONSTRAINT expenses_amount_positive CHECK ("amount" > 0);
//   ALTER TABLE incomes  ADD CONSTRAINT incomes_void_consistent
//     CHECK (("status" = 'VOIDED') = ("voidReason" IS NOT NULL AND "voidedAt" IS NOT NULL AND "voidedById" IS NOT NULL));
//   (same void_consistent check on expenses)
// Financial rows are never deleted: the application has no delete path. Optionally also add a
// BEFORE DELETE trigger on incomes/expenses/financial_transactions that raises an exception.

enum FinanceStatus {
  ACTIVE
  VOIDED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum AttachmentStatus {
  PENDING
  AVAILABLE
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

enum IntegrationRequestStatus {
  PENDING
  SUCCEEDED
  RETRYING
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum NotificationEmailStatus {
  NONE
  QUEUED
  SENT
  FAILED
}

model ExpenseHead {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(100)
  /// lower-cased trimmed name; enforces case-insensitive uniqueness per organization
  nameKey        String   @db.VarChar(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  expenses Expense[]

  @@unique([organizationId, nameKey])
  @@index([organizationId, isActive])
  @@map("expense_heads")
}

model Income {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @db.VarChar(3)
  date           DateTime      @db.Date
  category       String        @db.VarChar(100)
  reference      String?       @db.VarChar(200)
  description    String?       @db.Text
  /// id of a case owned by the cases module; intentionally not a foreign key across fragments
  relatedCaseId  String?       @db.Uuid
  status         FinanceStatus @default(ACTIVE)
  voidReason     String?       @db.Text
  voidedAt       DateTime?     @db.Timestamptz(6)
  voidedById     String?       @db.Uuid
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  transaction FinancialTransaction?
  payments    Payment[]

  @@index([organizationId, date])
  @@index([organizationId, status, date])
  @@index([organizationId, relatedCaseId])
  @@map("incomes")
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  expenseHeadId  String        @db.Uuid
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @db.VarChar(3)
  date           DateTime      @db.Date
  payee          String?       @db.VarChar(200)
  reference      String?       @db.VarChar(200)
  description    String?       @db.Text
  status         FinanceStatus @default(ACTIVE)
  voidReason     String?       @db.Text
  voidedAt       DateTime?     @db.Timestamptz(6)
  voidedById     String?       @db.Uuid
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  expenseHead ExpenseHead          @relation(fields: [expenseHeadId], references: [id], onDelete: Restrict)
  transaction FinancialTransaction?
  payments    Payment[]

  @@index([organizationId, date])
  @@index([organizationId, status, date])
  @@index([organizationId, expenseHeadId])
  @@map("expenses")
}

/// Settlement record (money actually received or paid), optionally confirmed by an external provider.
model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  incomeId       String?  @db.Uuid
  expenseId      String?  @db.Uuid
  method         String   @db.VarChar(50)
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @db.VarChar(3)
  paidAt         DateTime @db.Timestamptz(6)
  integrationId  String?  @db.Uuid
  externalId     String?  @db.VarChar(200)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  income  Income?  @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, integrationId, externalId])
  @@index([organizationId, paidAt])
  @@map("payments")
}

/// One ledger row per income/expense, written in the same database transaction as its source row.
/// Backs finance.transactions and keeps the unified listing cheap and consistent.
model FinancialTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  type           FinancialTransactionType
  incomeId       String?                  @unique @db.Uuid
  expenseId      String?                  @unique @db.Uuid
  date           DateTime                 @db.Date
  amount         Decimal                  @db.Decimal(18, 2)
  currency       String                   @db.VarChar(3)
  /// income category, or the expense head name at write time
  category       String                   @db.VarChar(100)
  reference      String?                  @db.VarChar(200)
  status         FinanceStatus            @default(ACTIVE)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  income  Income?  @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([organizationId, date])
  @@index([organizationId, type, date])
  @@map("financial_transactions")
}

model Attachment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  uploadedById   String           @db.Uuid
  /// randomized object key; never derived from the file name
  storageKey     String           @unique @db.VarChar(300)
  fileName       String           @db.VarChar(200)
  mimeType       String           @db.VarChar(100)
  sizeBytes      Int
  status         AttachmentStatus @default(PENDING)
  entityType     String?          @db.VarChar(50)
  entityId       String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  availableAt    DateTime?        @db.Timestamptz(6)

  accessLogs AttachmentAccessLog[]

  @@index([organizationId, uploadedById])
  @@index([organizationId, entityType, entityId])
  @@map("attachments")
}

/// Append-only evidence of every upload-URL and download-URL issuance.
model AttachmentAccessLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  attachmentId   String   @db.Uuid
  userId         String   @db.Uuid
  action         String   @db.VarChar(40)
  requestId      String?  @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, attachmentId])
  @@index([organizationId, userId, createdAt])
  @@map("attachment_access_logs")
}

model Notification {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  userId         String                  @db.Uuid
  type           String                  @db.VarChar(60)
  title          String                  @db.VarChar(200)
  body           String                  @db.Text
  data           Json?
  readAt         DateTime?               @db.Timestamptz(6)
  emailStatus    NotificationEmailStatus @default(NONE)
  emailAttempts  Int                     @default(0)
  emailError     String?                 @db.VarChar(500)
  emailSentAt    DateTime?               @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}

model Integration {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  provider       String            @db.VarChar(50)
  name           String            @db.VarChar(100)
  status         IntegrationStatus @default(ACTIVE)
  /// NAME of the environment variable / secret-manager key holding the webhook signing secret.
  /// Secrets themselves are never stored in the database.
  secretRef      String            @db.VarChar(100)
  config         Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  requests IntegrationRequest[]
  webhooks WebhookEvent[]

  @@unique([organizationId, provider, name])
  @@map("integrations")
}

/// Outbound call tracking: request, response, external id, status, retries.
model IntegrationRequest {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid
  integrationId   String                   @db.Uuid
  operation       String                   @db.VarChar(100)
  idempotencyKey  String                   @db.VarChar(200)
  status          IntegrationRequestStatus @default(PENDING)
  attempts        Int                      @default(0)
  maxAttempts     Int                      @default(5)
  /// redacted before storage (see integrations/redact.ts)
  requestPayload  Json
  responsePayload Json?
  httpStatus      Int?
  externalId      String?                  @db.VarChar(200)
  lastError       String?                  @db.VarChar(500)
  nextRetryAt     DateTime?                @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  completedAt     DateTime?                @db.Timestamptz(6)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@unique([integrationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([status, nextRetryAt])
  @@map("integration_requests")
}

/// Inbound webhook ledger. The unique (integrationId, eventId) pair is the idempotency guard.
model WebhookEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  integrationId      String             @db.Uuid
  eventId            String             @db.VarChar(200)
  eventType          String             @db.VarChar(100)
  status             WebhookEventStatus @default(RECEIVED)
  signatureTimestamp DateTime           @db.Timestamptz(6)
  payload            Json
  error              String?            @db.VarChar(500)
  receivedAt         DateTime           @default(now()) @db.Timestamptz(6)
  processedAt        DateTime?          @db.Timestamptz(6)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@unique([integrationId, eventId])
  @@index([organizationId, status])
  @@map("webhook_events")
}


// ---- fragment: reports.prisma
// Account 3 fragment. No datasource/generator blocks. Merged after schema.base.prisma.
// organizationId / requestedById are plain UUID columns on purpose (no @relation):
