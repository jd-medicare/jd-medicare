# Edge reverse proxy. Rendered by the nginx image's envsubst: only ${DOMAIN}, ${STORAGE_PUBLIC_ORIGIN} and ${CI_BYPASS_TOKEN} are substituted.
# Rate limits here are a COARSE first layer. The API must enforce its own per-account/per-IP limits (login, MFA, search, exports).
server_tokens off;
limit_req_status 429;
limit_conn_status 429;

# Behind a CDN/WAF: set the CDN ranges so $remote_addr is the real client (see docs/tls-cdn-waf.md).
# set_real_ip_from <CDN_CIDR>;
# real_ip_header CF-Connecting-IP;

# Optional STAGING-ONLY bypass of the EDGE limiter for the CI test runner (header X-CI-Bypass). App-level limits still apply.
# Leave CI_BYPASS_TOKEN empty in production: an empty token can never match (guarded below).
map $rl_exempt $auth_key { 1 ""; default $binary_remote_addr; }
map $rl_exempt $api_key  { 1 ""; default $binary_remote_addr; }
map "$request_method:$rl_exempt" $export_key { "POST:0" $binary_remote_addr; default ""; }   # POST only (polling GETs are not counted)

limit_req_zone $auth_key   zone=auth:10m rate=10r/m;
limit_req_zone $api_key    zone=api:20m rate=30r/s;
limit_req_zone $export_key zone=exports:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=perip:10m;

map $host $csp {
  default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${STORAGE_PUBLIC_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
}

upstream api_up { server api:3000; keepalive 32; }
upstream web_up { server web:8080; keepalive 16; }

server {
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;
  ssl_stapling on;
  ssl_stapling_verify on;
  resolver 1.1.1.1 9.9.9.9 valid=300s;

  set $rl_exempt 0;
  if ($http_x_ci_bypass = "${CI_BYPASS_TOKEN}") { set $rl_exempt 1; }
  if ($http_x_ci_bypass = "") { set $rl_exempt 0; }

  client_max_body_size 1m;          # uploads go straight to object storage via presigned URLs
  client_body_timeout 15s;
  client_header_timeout 15s;
  limit_conn perip 50;

  error_page 429 @rate_limited;
  location @rate_limited {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests","requestId":"$request_id"}}';
  }
  error_page 502 503 504 @upstream_down;
  location @upstream_down {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    return 503 '{"error":{"code":"UNAVAILABLE","message":"Service temporarily unavailable","requestId":"$request_id"}}';
  }

  # internal-only endpoints (never public)
  location ~ ^/(health|ready)$ {
    allow 127.0.0.1; allow 10.0.0.0/8; allow 172.16.0.0/12; allow 192.168.0.0/16; deny all;
    proxy_pass http://api_up;
    include /etc/nginx/snippets/proxy-common.conf;
  }
  location = /api/docs-json {      # OpenAPI is not public in staging/production
    allow 127.0.0.1; allow 10.0.0.0/8; allow 172.16.0.0/12; allow 192.168.0.0/16; deny all;
    proxy_pass http://api_up;
    include /etc/nginx/snippets/proxy-common.conf;
  }
  location = /live {
    proxy_pass http://api_up;
    include /etc/nginx/snippets/proxy-common.conf;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # strict limits on credential and expensive endpoints
  location ~ ^/api/v1/auth/(login|mfa/verify|password/) {
    limit_req zone=auth burst=5 nodelay;
    proxy_pass http://api_up;
    include /etc/nginx/snippets/proxy-common.conf;
    proxy_hide_header Cache-Control;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
  location ^~ /api/v1/reports/exports {
    limit_req zone=exports burst=3 nodelay;
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://api_up;
    include /etc/nginx/snippets/proxy-common.conf;
    proxy_hide_header Cache-Control;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
  location /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://api_up;
    include /etc/nginx/snippets/proxy-common.conf;
    proxy_hide_header Cache-Control;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
  location / {
    proxy_pass http://web_up;
    include /etc/nginx/snippets/proxy-common.conf;
    include /etc/nginx/snippets/security-headers.conf;
  }
}
